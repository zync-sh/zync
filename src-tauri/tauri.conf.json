{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zync",
  "version": "2.33.0",
  "identifier": "in.thesudoer.zync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Zync",
        "width": 1300,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*",
        "font-src": "'self' data: asset: http://asset.localhost",
        "img-src": "'self' data: blob: asset: http://asset.localhost https:",
        "media-src": "'self' blob: https:",
        "script-src": "'self' 'unsafe-inline' asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline' asset: http://asset.localhost",
        "worker-src": "'self' blob:",
        "frame-src": "'self' about:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*",
        "font-src": "'self' data: asset: http://asset.localhost",
        "img-src": "'self' data: blob: asset: http://asset.localhost https:",
        "media-src": "'self' blob: https:",
        "script-src": "'self' 'unsafe-inline' asset: http://asset.localhost",
        "style-src": "'self' 'unsafe-inline' asset: http://asset.localhost",
        "worker-src": "'self' blob:",
        "frame-src": "'self' about:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "script-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCONFIG/plugins/**/*"
        ]
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/icons/hicolor/128x128/apps/zync.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/32x32/apps/zync.png": "icons/32x32.png"
        }
      },
      "rpm": {
        "files": {}
      },
      "appimage": {
        "files": {}
      }
    },
    "targets": [
      "deb",
      "appimage",
      "rpm",
      "nsis",
      "app",
      "dmg"
    ],
    "resources": {}
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/zync-sh/zync/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyNkJEQjI3OTQ3OENCODYKUldTR3kzaVVKOXRyWW91Wmh0TDdFc3ptSGtla3c2TnBmbDE1V0hiYXlHUGxKREhqNnVNbHZhaW8K"
    }
  }
}
